# ---------------------------------------------------------------------------
# Consolidated environment template for both services and Docker Compose.
#
# Copy this file to `.env` (root) for Docker Compose:
#   cp .env.example .env
# Each service also has its own example file for non-Docker local development:
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env.local
#
# Every value is optional. With all of them empty the full demo works: the
# recommendation is worded by built-in rules and analyses are not stored.
# ---------------------------------------------------------------------------

# --- PostgreSQL (optional) -------------------------------------------------
# Stores each analysis when set. `postgres://`, `postgresql://` and
# `postgresql+psycopg://` are accepted. URL-encode special characters in the
# password (e.g. `@` -> `%40`).
DATABASE_URL=

# --- AI provider (optional) ------------------------------------------------
# Phrases the recommendation. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any model your account can use with the Responses API.
OPENAI_MODEL=gpt-4.1-mini

# --- Demo ------------------------------------------------------------------
# "Today" for the projection (YYYY-MM-DD). Defaults to the data file's as_of_date.
DEMO_TODAY=

# --- Backend ---------------------------------------------------------------
# Allowed browser origins for CORS (JSON array or comma separated list).
CORS_ORIGINS=["http://localhost:3000"]
# Development convenience: create missing tables on startup.
# Not a substitute for migrations in production.
AUTO_CREATE_TABLES=true
BACKEND_PORT=8000

# --- Frontend: public variables only ---------------------------------------
# Anything prefixed with NEXT_PUBLIC_ is embedded in the browser bundle.
# Never put secrets (API keys, DB URLs) here.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
FRONTEND_PORT=3000
