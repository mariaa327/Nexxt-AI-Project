# ---------------------------------------------------------------------------
# Consolidated environment template for both services and Docker Compose.
#
# Copy this file to `.env` (root) for Docker Compose:
#   cp .env.example .env
# Each service also has its own example file for non-Docker local development:
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env.local
#
# Defaults work as-is: `docker compose up --build` starts PostgreSQL, creates
# one database per demo user and seeds them. Without AWS credentials the
# recommendation is worded by built-in rules.
# ---------------------------------------------------------------------------

# --- PostgreSQL (the "db" service) ------------------------------------------
# Development-only credentials for the local demo database server.
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank
POSTGRES_PORT=5432

# --- Sessions ----------------------------------------------------------------
# Signs login tokens. Set any long random string to keep users logged in across
# backend restarts (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
SESSION_SECRET=

# --- AI provider: Amazon Bedrock (optional) -------------------------------
# Phrases the recommendation. Without credentials the rules wording is used.
# Never put real credentials in this file: it is committed. Use .env.
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5

# --- Demo ------------------------------------------------------------------
# "Today" for the projection (YYYY-MM-DD). Defaults to the data file's as_of_date.
DEMO_TODAY=

# --- Backend ---------------------------------------------------------------
# Allowed browser origins for CORS (JSON array or comma separated list).
CORS_ORIGINS=["http://localhost:3000"]
BACKEND_PORT=8000

# --- Frontend: public variables only ---------------------------------------
# Anything prefixed with NEXT_PUBLIC_ is embedded in the browser bundle.
# Never put secrets (API keys, DB URLs) here.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
FRONTEND_PORT=3000
