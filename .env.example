# ---------------------------------------------------------------------------
# Consolidated environment template for both services and Docker Compose.
#
# Copy this file to `.env` (root) for Docker Compose:
#   cp .env.example .env
# Each service also has its own example file for non-Docker local development:
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env.local
#
# Leave values empty if you only want to run the health check, tests, linting
# and the build. Empty values are treated as "not configured".
# ---------------------------------------------------------------------------

# --- Supabase PostgreSQL ---------------------------------------------------
# Required for persistence. Get it from the Supabase dashboard:
# Project Settings -> Database -> Connection string -> URI.
# URL-encode special characters in the password (e.g. `@` -> `%40`).
# `postgres://`, `postgresql://` and `postgresql+psycopg://` are all accepted.
DATABASE_URL=

# --- Supabase Auth and JWT verification ------------------------------------
# Required for authenticated requests.
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Optional. Defaults to $SUPABASE_URL/auth/v1/.well-known/jwks.json, which is
# the endpoint for modern asymmetric signing keys. Only set this if you need a
# different endpoint.
SUPABASE_JWKS_URL=

# LEGACY / OPTIONAL. Shared HS256 secret from older Supabase projects. Only used
# when a token's header says HS256 and this value is set. Modern projects use
# asymmetric signing keys + JWKS; leave this empty unless you know you need it.
SUPABASE_JWT_SECRET=

# --- AI provider -----------------------------------------------------------
# Required for agent runs. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Any model your account can use with the Responses API.
OPENAI_MODEL=gpt-4.1-mini

# --- Backend ---------------------------------------------------------------
# Allowed browser origins for CORS (JSON array or comma separated list).
CORS_ORIGINS=["http://localhost:3000"]

# Development convenience: create missing tables on startup.
# Not a substitute for migrations in production.
AUTO_CREATE_TABLES=true

BACKEND_PORT=8000

# --- Frontend: public variables only ---------------------------------------
# Anything prefixed with NEXT_PUBLIC_ is embedded in the browser bundle.
# Never put secrets (API keys, DB URLs, JWT secrets) here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for the publishable key; optional.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000/api

FRONTEND_PORT=3000
