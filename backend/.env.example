# Backend configuration. Copy to backend/.env:
#   cp .env.example .env
# Empty values are treated as "not configured".

# --- Database --------------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# URL-encode special characters in the password (e.g. `@` -> `%40`).
# Required for persistence; the app still starts without it.
DATABASE_URL=

# --- Supabase Auth ---------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
# Required to verify access tokens.
SUPABASE_URL=

# Optional. Defaults to $SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=

# LEGACY / OPTIONAL. HS256 shared secret for old projects. Prefer JWKS.
SUPABASE_JWT_SECRET=

# Optional. Expected `aud` claim; defaults to "authenticated".
SUPABASE_JWT_AUDIENCE=authenticated

# --- AI provider -----------------------------------------------------------
# Required for POST /api/agent/run.
OPENAI_API_KEY=

OPENAI_MODEL=gpt-4.1-mini

# --- Application -----------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
AUTO_CREATE_TABLES=true
APP_ENV=development
LOG_LEVEL=INFO
