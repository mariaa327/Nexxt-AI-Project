# Backend configuration. Copy to backend/.env:
#   cp .env.example .env
# Empty values are treated as "not configured". Everything works with this file
# as-is: no database means analyses are not stored, no AI key means the
# recommendation is worded by the built-in rules.

# --- Database (optional) ---------------------------------------------------
# PostgreSQL URI (e.g. Supabase dashboard -> Project Settings -> Database).
# URL-encode special characters in the password (e.g. `@` -> `%40`).
DATABASE_URL=

# --- AI provider (optional) ------------------------------------------------
# Used to phrase the recommendation; the engine computes all numbers either way.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Demo client data ------------------------------------------------------
# Defaults to app/data/client1_date.json.
DEMO_DATA_PATH=
# "Today" for the projection (YYYY-MM-DD). Defaults to the file's as_of_date.
DEMO_TODAY=

# --- Application -----------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
AUTO_CREATE_TABLES=true
APP_ENV=development
LOG_LEVEL=INFO
