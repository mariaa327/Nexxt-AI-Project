# Backend configuration. Copy to backend/.env:
#   cp .env.example .env
# Works as-is with the PostgreSQL from `docker compose up -d db`. Without AWS
# credentials the recommendation is worded by the built-in rules.

# --- Databases (PostgreSQL) ------------------------------------------------
# Server connection that may create databases. The directory database and one
# database per demo user (client_<username>) are created and seeded on startup.
DATABASE_ADMIN_URL=postgresql://bank:bank@localhost:5432/postgres
PROVISION_ON_STARTUP=true

# --- Sessions ----------------------------------------------------------------
# Signs login tokens; empty means a random secret per process (restart = logout).
SESSION_SECRET=
SESSION_HOURS=8

# --- AI provider: Amazon Bedrock (optional) -------------------------------
# Phrases the recommendation; the engine computes all numbers either way.
# Without credentials the built-in rules wording is used. Hackathon credentials
# are temporary (session token): refresh all three when they expire.
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5

# --- Demo ------------------------------------------------------------------
# "Today" for the projection (YYYY-MM-DD). Defaults to the file's as_of_date.
DEMO_TODAY=

# --- Application -----------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
APP_ENV=development
LOG_LEVEL=INFO
# Seconds before the AI provider call gives up and the rules wording is used.
AI_TIMEOUT_SECONDS=20
# Simulated "approve in your banking app" delay for payment verification.
DEMO_APPROVAL_SECONDS=3
